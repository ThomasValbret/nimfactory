    fix(walk): handle leading shallow magic correctly (#30)
    
    Closes #29
    
    ```
    foo/a.txt
    bar/a.txt
    baz/a.txt
    ```
    
    ```nim
    import glob
    import sequtils
    
    echo toSeq(walkGlob("*/a.txt"))
    # -> @["foo/a.txt", "bar/a.txt", "baz/a.txt"]
    ```

