{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nimfactory.result/0.1",
  "title": "CommonResult",
  "type": "object",
  "required": ["schema", "status", "outputs", "needs", "diagnostics"],
  "properties": {
    "schema": { "const": "nimfactory.result/0.1" },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "blocked", "failed", "cancelled"]
    },
    "outputs": { "type": "object" },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "target": { "type": "string" },
          "selector": { "type": "string" },
          "required": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "phase": { "type": "string" },
          "message": { "type": "string" },
          "retryable": { "type": "boolean" },
          "refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "read_set_ref": { "type": ["string", "null"] },
    "usage_ref": { "type": ["string", "null"] },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "phase": { "type": "string" },
        "retryable": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
